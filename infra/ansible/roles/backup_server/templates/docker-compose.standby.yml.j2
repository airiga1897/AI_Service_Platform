# VPS2 — Standby стек
# PostgreSQL: hot standby (реплика с VPS1, read-only)
# Остальные сервисы: запущены в ожидании, но НЕ принимают внешний трафик
# При failover: запустить docker-compose.prod.yml поверх этого

services:
  db:
    image: postgres:15-alpine
    container_name: "{{ db_standby_container_name }}"
    volumes:
      - {{ db_standby_volume }}:/var/lib/postgresql/data
    environment:
      POSTGRES_DB: "{{ vault_db_name }}"
      POSTGRES_USER: "{{ vault_db_user }}"
      POSTGRES_PASSWORD: "{{ vault_db_password }}"
    restart: always
    networks:
      - backend

  redis:
    image: redis:7-alpine
    volumes:
      - redis_data:/data
    command: redis-server --appendonly yes
    restart: always
    networks:
      - backend

  web:
    image: "{{ app_image }}:{{ '${IMAGE_TAG:-latest}' }}"
    command: gunicorn --bind 0.0.0.0:8000 --workers 4 --threads 2 {{ app_wsgi_module }}
    volumes:
      - static_volume:/app/staticfiles
      - media_volume:/app/media
    env_file:
      - .env
    depends_on:
      - db
      - redis
    # НЕ публикуем порты — не принимаем трафик в standby режиме
    restart: always
    networks:
      - backend

  nginx:
    image: nginx:alpine
    volumes:
      - ./nginx/nginx.conf:/etc/nginx/conf.d/default.conf:ro
      - static_volume:/app/staticfiles:ro
      - media_volume:/app/media:ro
      - certbot_conf:/etc/letsencrypt
    # НЕ публикуем порты — ожидание
    restart: always
    networks:
      - backend

networks:
  backend:

volumes:
  {{ db_standby_volume }}:
    external: true
  redis_data:
  static_volume:
  media_volume:
  certbot_conf:
