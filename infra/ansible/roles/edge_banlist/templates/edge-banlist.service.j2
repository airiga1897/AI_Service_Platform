[Unit]
Description=AI Service Platform edge banlist collector
After=docker.service
Requires=docker.service

[Service]
Type=oneshot
ExecStart={{ edge_banlist_script }} \
  --mode {{ edge_banlist_effective_config.mode | default(edge_banlist_mode) }} \
  --socket {{ edge_banlist_haproxy_socket }} \
  --state-dir {{ edge_banlist_state_dir }} \
  --log-file {{ edge_banlist_log_file }} \
  --manual-blocked-file {{ edge_banlist_manual_blocked_file }} \
  --generated-blocked-file {{ edge_banlist_generated_blocked_file }} \
  --mgmt-allowlist-file {{ edge_banlist_mgmt_allowlist_file }} \
  --reload-command '{{ edge_banlist_reload_command }}' \
  --ban-ttl-seconds {{ edge_banlist_effective_config.ban_ttl_seconds | default(edge_banlist_ban_ttl_seconds) }} \
  --min-score {{ edge_banlist_effective_config.min_score | default(edge_banlist_min_score) }} \
  --http-req-rate-threshold {{ edge_banlist_effective_config.http_req_rate_threshold | default(edge_banlist_http_req_rate_threshold) }} \
  --http-err-rate-threshold {{ edge_banlist_effective_config.http_err_rate_threshold | default(edge_banlist_http_err_rate_threshold) }} \
  --tcp-conn-rate-threshold {{ edge_banlist_effective_config.tcp_conn_rate_threshold | default(edge_banlist_tcp_conn_rate_threshold) }} \
  --tcp-conn-cur-threshold {{ edge_banlist_effective_config.tcp_conn_cur_threshold | default(edge_banlist_tcp_conn_cur_threshold) }} \
{% for cidr in edge_banlist_never_ban_cidrs %}
  --never-ban-cidr {{ cidr }} \
{% endfor %}
  --never-ban-cidr 0.0.0.0/32
