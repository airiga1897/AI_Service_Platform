global
    log stdout format raw local0
    maxconn 4096
    tune.ssl.default-dh-param 2048

defaults
    log global
    option dontlognull
    timeout connect 5s
    timeout client  50s
    timeout server  50s

frontend stats_local
    bind {{ edge_haproxy_stats_bind }}
    mode http
    stats enable
    stats uri /stats
    stats refresh 10s

backend be_acme_placeholder
    mode http
    http-request return status 404 content-type text/plain string "ACME backend is not configured yet"

frontend http_in
    bind *:80
    mode http
    acl is_acme path_beg /.well-known/acme-challenge/
    http-request deny deny_status 403 if { src -f /usr/local/etc/haproxy/lists/blocked_ips.lst } !is_acme
    use_backend be_acme_placeholder if is_acme
    http-request redirect scheme https code 301 unless is_acme

frontend https_in
    bind *:443
    mode tcp
    option tcplog
    tcp-request inspect-delay 5s
    tcp-request content accept if { req_ssl_hello_type 1 }
    tcp-request connection reject if { src -f /usr/local/etc/haproxy/lists/blocked_ips.lst }
    tcp-request content track-sc0 src table st_tcp_rates
    tcp-request content reject if { sc0_conn_rate gt {{ edge_haproxy_tcp_rate_limit }} }
    tcp-request content reject if { sc0_conn_cur gt {{ edge_haproxy_tcp_conn_cur_limit }} }

    acl is_softether req_ssl_sni -m beg vpn.
    tcp-request content reject unless is_softether
    use_backend be_softether_https if is_softether

backend be_softether_https
    mode tcp
    option tcp-check
    server softether {{ edge_haproxy_softether_host }}:443 check inter 5s fall 3 rise 2

frontend softether_tcp_992
    bind *:992
    mode tcp
    option tcplog
    tcp-request connection reject if { src -f /usr/local/etc/haproxy/lists/blocked_ips.lst }
    tcp-request content track-sc0 src table st_tcp_rates
    tcp-request content reject if { sc0_conn_rate gt {{ edge_haproxy_tcp_rate_limit }} }
    tcp-request content reject if { sc0_conn_cur gt {{ edge_haproxy_tcp_conn_cur_limit }} }
    default_backend be_softether_992

backend be_softether_992
    mode tcp
    option tcp-check
    server softether {{ edge_haproxy_softether_host }}:992 check inter 5s fall 3 rise 2

frontend softether_tcp_1194
    bind *:1194
    mode tcp
    option tcplog
    tcp-request connection reject if { src -f /usr/local/etc/haproxy/lists/blocked_ips.lst }
    tcp-request content track-sc0 src table st_tcp_rates
    tcp-request content reject if { sc0_conn_rate gt {{ edge_haproxy_tcp_rate_limit }} }
    tcp-request content reject if { sc0_conn_cur gt {{ edge_haproxy_tcp_conn_cur_limit }} }
    default_backend be_softether_1194

backend be_softether_1194
    mode tcp
    option tcp-check
    server softether {{ edge_haproxy_softether_host }}:1194 check inter 5s fall 3 rise 2

frontend softether_mgmt
    bind *:5555
    mode tcp
    option tcplog
    tcp-request connection reject if { src -f /usr/local/etc/haproxy/lists/blocked_ips.lst }
    tcp-request connection reject if !{ src -f /usr/local/etc/haproxy/lists/vpn_mgmt_ips.lst }
    default_backend be_softether_mgmt

backend be_softether_mgmt
    mode tcp
    option tcp-check
    server softether {{ edge_haproxy_softether_host }}:5555 check inter 5s fall 3 rise 2

backend st_tcp_rates
    stick-table type ip size 100k expire 5m store conn_rate({{ edge_haproxy_tcp_rate_window }}),conn_cur
