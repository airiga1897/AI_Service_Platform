groups:
  - name: mycleanbot_alerts
    rules:
      - alert: MyCleanBotEndpointDown
        expr: probe_success{job="mycleanbot_http"} == 0
        for: 2m
        labels:
          severity: critical
        annotations:
          summary: "MyCleanBot endpoint is unavailable"
          description: "VPN-only probe failed for {% raw %}{{ $labels.target }}{% endraw %}."

      - alert: MyCleanBotBackupStale
        expr: time() - mycleanbot_backup_last_success_timestamp_seconds > 129600
        for: 15m
        labels:
          severity: critical
        annotations:
          summary: "MyCleanBot backup is stale"
          description: "No successful platform PostgreSQL backup for more than 36 hours."

      - alert: MyCleanBotRestoreRehearsalStale
        expr: time() - mycleanbot_restore_rehearsal_last_success_timestamp_seconds > 691200
        for: 30m
        labels:
          severity: warning
        annotations:
          summary: "MyCleanBot restore rehearsal is stale"
          description: "No successful scratch restore rehearsal for more than eight days."
