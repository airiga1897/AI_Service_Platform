global:
  scrape_interval: 15s
  evaluation_interval: 15s

rule_files:
  - /etc/prometheus/alert-rules.yml
  - /etc/prometheus/mycleanbot-alert-rules.yml

alerting:
  alertmanagers:
    - static_configs:
        - targets: ["alertmanager:{{ alertmanager_port }}"]

scrape_configs:
  - job_name: "prometheus"
    static_configs:
      - targets: ["localhost:{{ prometheus_port }}"]

  - job_name: "node_vps1"
    static_configs:
      - targets: ["{{ groups['prod'][0] }}:{{ hostvars[groups['prod'][0]]['node_exporter_port'] }}"]
        labels:
          instance: "VPS1-prod"

  - job_name: "node_vps6"
    static_configs:
      - targets: ["localhost:{{ node_exporter_port }}"]
        labels:
          instance: "VPS6-management"

  - job_name: "postgres_vps1"
    static_configs:
      - targets: ["{{ groups['prod'][0] }}:{{ hostvars[groups['prod'][0]]['postgres_exporter_port'] }}"]
        labels:
          instance: "VPS1-postgres"

  - job_name: "nginx_vps1"
    static_configs:
      - targets: ["{{ groups['prod'][0] }}:{{ hostvars[groups['prod'][0]]['nginx_exporter_port'] }}"]
        labels:
          instance: "VPS1-nginx"

  - job_name: "haproxy_vps1"
    static_configs:
      - targets: ["{{ groups['prod'][0] }}:{{ hostvars[groups['prod'][0]]['haproxy_exporter_port'] }}"]
        labels:
          instance: "VPS1-haproxy"

{% if mycleanbot_monitor_url | default('') %}
  - job_name: "mycleanbot_http"
    metrics_path: /probe
    params:
      module: [http_2xx]
    static_configs:
      - targets:
          - "{{ mycleanbot_monitor_url }}/livez"
          - "{{ mycleanbot_monitor_url }}/healthz"
        labels:
          instance: "mycleanbot-prod"
          access: "vpn-only"
    relabel_configs:
      - source_labels: [__address__]
        target_label: __param_target
      - source_labels: [__param_target]
        target_label: target
      - target_label: __address__
        replacement: blackbox-exporter:9115
{% endif %}
