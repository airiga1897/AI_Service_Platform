proxy_cache_path /var/cache/nginx/mycleanbot-static levels=1:2 keys_zone=mycleanbot_static:4m max_size=64m inactive=24h use_temp_path=off;

upstream mycleanbot_backend {
    server {{ mycleanbot_vpn_access_backend_ipv4 }}:{{ mycleanbot_vpn_access_backend_port }};
    keepalive 16;
}

server {
    listen 443 ssl;
    http2 on;
    server_name {{ mycleanbot_vpn_access_hostname }};

    ssl_certificate /etc/nginx/tls/fullchain.pem;
    ssl_certificate_key /etc/nginx/tls/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_session_cache shared:mycleanbot_tls:2m;
    ssl_session_timeout 1d;
    server_tokens off;

    allow 127.0.0.1;
    allow {{ mycleanbot_vpn_access_operator_cidr }};
    allow {{ mycleanbot_vpn_access_router_ipv4 }};
    deny all;

    location = /ingress-livez {
        access_log off;
        return 204;
    }

    location /static/ {
        proxy_pass http://mycleanbot_backend;
        proxy_http_version 1.1;
        proxy_set_header Connection "";
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto https;
        proxy_cache mycleanbot_static;
        proxy_cache_valid 200 1h;
        proxy_cache_lock on;
        add_header X-Content-Type-Options nosniff always;
    }

    location / {
        proxy_pass http://mycleanbot_backend;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_http_version 1.1;
        proxy_set_header Connection "";
        proxy_connect_timeout 5s;
        proxy_read_timeout 60s;
    }
}
