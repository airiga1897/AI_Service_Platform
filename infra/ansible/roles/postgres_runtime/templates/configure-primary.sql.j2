DO $$
BEGIN
  IF NOT EXISTS (SELECT FROM pg_roles WHERE rolname = '{{ postgres_runtime_model.app_user | replace("'", "''") }}') THEN
    EXECUTE format(
      'CREATE ROLE %I LOGIN PASSWORD %L',
      '{{ postgres_runtime_model.app_user | replace("'", "''") }}',
      '{{ postgres_runtime_secret_map.POSTGRES_APP_PASSWORD | replace("'", "''") }}'
    );
  ELSE
    EXECUTE format(
      'ALTER ROLE %I WITH LOGIN PASSWORD %L',
      '{{ postgres_runtime_model.app_user | replace("'", "''") }}',
      '{{ postgres_runtime_secret_map.POSTGRES_APP_PASSWORD | replace("'", "''") }}'
    );
  END IF;
END$$;

SELECT format(
  'CREATE DATABASE %I OWNER %I',
  '{{ postgres_runtime_model.database | replace("'", "''") }}',
  '{{ postgres_runtime_model.app_user | replace("'", "''") }}'
)
WHERE NOT EXISTS (
  SELECT FROM pg_database WHERE datname = '{{ postgres_runtime_model.database | replace("'", "''") }}'
)\gexec

{% for product in postgres_runtime_model.managed_databases %}
DO $$
BEGIN
  IF NOT EXISTS (SELECT FROM pg_roles WHERE rolname = '{{ product.owner_role }}') THEN
    EXECUTE format(
      'CREATE ROLE %I WITH LOGIN NOSUPERUSER NOCREATEDB NOCREATEROLE NOREPLICATION PASSWORD %L',
      '{{ product.owner_role }}',
      '{{ postgres_runtime_secret_map[product.password_secret] | replace("'", "''") }}'
    );
  ELSE
    EXECUTE format(
      'ALTER ROLE %I WITH LOGIN NOSUPERUSER NOCREATEDB NOCREATEROLE NOREPLICATION PASSWORD %L',
      '{{ product.owner_role }}',
      '{{ postgres_runtime_secret_map[product.password_secret] | replace("'", "''") }}'
    );
  END IF;
END$$;

SELECT format(
  'CREATE DATABASE %I OWNER %I',
  '{{ product.database }}',
  '{{ product.owner_role }}'
)
WHERE NOT EXISTS (
  SELECT FROM pg_database WHERE datname = '{{ product.database }}'
)\gexec

SELECT format(
  'ALTER DATABASE %I OWNER TO %I',
  '{{ product.database }}',
  '{{ product.owner_role }}'
)\gexec

\connect {{ product.database }}
{% for extension in product.extensions %}
CREATE EXTENSION IF NOT EXISTS {{ extension }};
{% endfor %}
\connect postgres
{% endfor %}

DO $$
BEGIN
  IF NOT EXISTS (SELECT FROM pg_roles WHERE rolname = '{{ postgres_runtime_model.replication_user | replace("'", "''") }}') THEN
    EXECUTE format(
      'CREATE ROLE %I WITH REPLICATION LOGIN PASSWORD %L',
      '{{ postgres_runtime_model.replication_user | replace("'", "''") }}',
      '{{ postgres_runtime_secret_map.POSTGRES_REPLICATION_PASSWORD | replace("'", "''") }}'
    );
  ELSE
    EXECUTE format(
      'ALTER ROLE %I WITH REPLICATION LOGIN PASSWORD %L',
      '{{ postgres_runtime_model.replication_user | replace("'", "''") }}',
      '{{ postgres_runtime_secret_map.POSTGRES_REPLICATION_PASSWORD | replace("'", "''") }}'
    );
  END IF;
END$$;

{% for _standby_alias, slot in postgres_runtime_model.replication_slots.items() %}
SELECT pg_create_physical_replication_slot('{{ slot | replace("'", "''") }}')
WHERE NOT EXISTS (
  SELECT 1 FROM pg_replication_slots WHERE slot_name = '{{ slot | replace("'", "''") }}'
);
{% endfor %}
