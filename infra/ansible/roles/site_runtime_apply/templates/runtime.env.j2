ENVIRONMENT=prod
DEBUG=false
{% if site_runtime_publication_preserved | bool %}
ALLOWED_HOSTS={{ ([site_runtime_model.runtime_intent.internal_host] + site_runtime_model.runtime_contract.publication.allowed_hosts + ['localhost', '127.0.0.1']) | join(',') }}
CSRF_TRUSTED_ORIGINS={{ site_runtime_model.runtime_contract.publication.csrf_trusted_origins | join(',') }}
{% else %}
ALLOWED_HOSTS={{ site_runtime_model.runtime_intent.internal_host }},localhost,127.0.0.1
{% endif %}
DB_ENGINE=django.db.backends.postgresql
DB_HOST=172.30.8.10
DB_PORT=5432
DB_NAME={{ site_runtime_instance | replace('-', '_') }}
DB_USER={{ site_runtime_instance | replace('-', '_') }}
CELERY_BROKER_URL=redis://127.0.0.1:6379/0
SENTRY_RELEASE={{ site_runtime_model.distribution_digest }}
SECRET_KEY={{ site_runtime_secret_env.SECRET_KEY | to_json }}
DB_PASSWORD={{ site_runtime_secret_env.DB_PASSWORD | to_json }}
{% for item in site_runtime_secret_env | dict2items | sort(attribute='key') %}
{% if item.key not in ['SECRET_KEY', 'DB_PASSWORD'] %}{{ item.key }}={{ item.value | to_json }}
{% endif %}
{% endfor %}
