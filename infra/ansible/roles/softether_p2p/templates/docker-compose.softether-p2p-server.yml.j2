---
services:
  softether-p2p-server:
    image: {{ softether_p2p_server_image }}
    container_name: {{ softether_p2p_server_container_name }}
    expose:
      - "443/tcp"
      - "5555/tcp"
    volumes:
      - ./softether_data:/mnt
      - ./softether_logs:/usr/local/bin/server_log
      - ./adminip.txt:/usr/local/bin/adminip.txt:ro
      - /etc/localtime:/etc/localtime:ro
    restart: always
    networks:
      {{ softether_p2p_model.network_name }}:
        ipv4_address: {{ softether_p2p_model.container_ipv4 }}
{% if softether_p2p_model.service_network.name | default('') %}
      {{ softether_p2p_model.service_network.name }}:
        ipv4_address: {{ softether_p2p_model.service_network.container_ipv4 }}
{% endif %}

networks:
  {{ softether_p2p_model.network_name }}:
    external: true
{% if softether_p2p_model.service_network.name | default('') %}
  {{ softether_p2p_model.service_network.name }}:
    external: true
{% endif %}
