services:
  softether-cascade:
    image: {{ vpn_cascade_image }}
    container_name: {{ vpn_cascade_container_name }}
    cap_add:
      - NET_ADMIN
    sysctls:
      net.ipv4.ip_forward: "1"
    devices:
      - /dev/net/tun:/dev/net/tun
{% if vpn_cascade_haproxy_entrypoints_enabled | default(false) %}
    expose:
      - "443/tcp"
      - "992/tcp"
      - "5555/tcp"
{% else %}
    ports:
      - "{{ vpn_cascade_host_https_port }}:443/tcp"
      - "{{ vpn_cascade_host_alt_port }}:992/tcp"
      - "{{ vpn_cascade_host_management_port }}:5555/tcp"
{% endif %}
    volumes:
      - ./softether_data:/mnt
      - ./softether_logs:/usr/local/bin/server_log
      - ./adminip.txt:/usr/local/bin/adminip.txt:ro
      - /etc/localtime:/etc/localtime:ro
    restart: always
    networks:
      {{ vpn_cascade_network_name }}:
        ipv4_address: {{ vpn_cascade_container_ipv4 }}
      {{ vpn_cascade_management_network_name }}:
        ipv4_address: {{ vpn_cascade_management_container_ipv4 }}
      {{ vpn_cascade_policy_network_name }}:
        ipv4_address: {{ vpn_cascade_policy_container_ipv4 }}

  policy-router:
    image: {{ vpn_cascade_policy_router_image }}
    container_name: {{ vpn_cascade_policy_router_container_name }}
    network_mode: "service:softether-cascade"
    cap_add:
      - NET_ADMIN
    depends_on:
      - softether-cascade
    command: ["sh", "-c", "while true; do sleep 3600; done"]
    restart: always

networks:
  {{ vpn_cascade_network_name }}:
    external: true
  {{ vpn_cascade_management_network_name }}:
    external: true
  {{ vpn_cascade_policy_network_name }}:
    external: true
