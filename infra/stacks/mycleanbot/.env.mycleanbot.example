# Secret values stay blank in Git. Install the real file with mode 0600.
DATABASE_URL=
DJANGO_SECRET_KEY=
MASTER_ENCRYPTION_KEY=
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
DJANGO_ALLOWED_HOSTS=
DJANGO_CSRF_TRUSTED_ORIGINS=
# Compatibility alias consumed by the currently published immutable image.
CSRF_TRUSTED_ORIGINS=

DJANGO_DEBUG=false
TZ=Europe/Moscow
LOG_LEVEL=INFO
MAX_REQUEST_BYTES=65536
WORKER_HEARTBEAT_SECONDS=10
STATUS_MESSAGE_TTL_SECONDS=15
MAX_TELEGRAM_ACCOUNTS=10
