# Installed as /etc/ai-service-platform/mycleanbot-backup.env with mode 0600.
# Values are created at the production-credentials gate and never committed.
RESTIC_REPOSITORY=
RESTIC_PASSWORD_FILE=
POSTGRES_ADMIN_URL=
PROMETHEUS_TEXTFILE=/var/lib/node_exporter/textfile_collector/mycleanbot.prom
SCRATCH_POSTGRES_IMAGE=
