[Unit]
Description=AI Service Platform MyCleanBot PostgreSQL backup
After=network-online.target mycleanbot-backup-routes.service
Requires=mycleanbot-backup-routes.service

[Service]
Type=oneshot
User=root
ExecStart=/usr/local/bin/ai-service-mycleanbot-backup backup
Nice=10
IOSchedulingClass=best-effort
IOSchedulingPriority=7

[Install]
WantedBy=multi-user.target
