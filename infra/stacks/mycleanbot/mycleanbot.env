# Tracked, non-secret production configuration for MyCleanBot.
# VPN-only hostname. Initial name resolution is installed on the operator
# workstation through its hosts file; no public ingress is created.
DJANGO_ALLOWED_HOSTS=mycleanbot.mine-craft.su,127.0.0.1
DJANGO_CSRF_TRUSTED_ORIGINS=https://mycleanbot.mine-craft.su
# Compatibility alias consumed by the currently published immutable image.
CSRF_TRUSTED_ORIGINS=https://mycleanbot.mine-craft.su

DJANGO_DEBUG=false
TZ=Europe/Moscow
LOG_LEVEL=INFO
CACHE_URL=redis://127.0.0.1:6379/0
DB_CONN_MAX_AGE=300
DASHBOARD_CACHE_TTL_SECONDS=15
DASHBOARD_POLL_SECONDS=15
ACTIVE_SCAN_POLL_SECONDS=5
MAX_REQUEST_BYTES=65536
WORKER_HEARTBEAT_SECONDS=10
MINI_APP_RECONCILE_SECONDS=300
MINI_APP_DISCOVERY_SECONDS=21600
STATUS_MESSAGE_TTL_SECONDS=15
MAX_TELEGRAM_ACCOUNTS=10
