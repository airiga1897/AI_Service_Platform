# Render only at the approved VPS-change gate.
# Required substitutions: VPN_LISTEN_IP, VPN_SERVER_NAME, TLS_CERTIFICATE, TLS_KEY.
server {
    listen ${VPN_LISTEN_IP}:443 ssl;
    server_name ${VPN_SERVER_NAME};

    ssl_certificate ${TLS_CERTIFICATE};
    ssl_certificate_key ${TLS_KEY};

    location / {
        proxy_pass http://127.0.0.1:8040;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_http_version 1.1;
    }
}
