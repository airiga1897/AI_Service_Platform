# Render only at the approved VPS-change gate.
# This file documents the private container contract. The Ansible role owns the
# concrete rendered file and refuses to start without an existing TLS certificate.
proxy_cache_path /var/cache/nginx/mycleanbot-static levels=1:2 keys_zone=mycleanbot_static:4m max_size=64m inactive=24h use_temp_path=off;

upstream mycleanbot_backend {
    server ${MYCLEANBOT_BACKEND_IP}:${MYCLEANBOT_BACKEND_PORT};
    keepalive 16;
}

server {
    listen 443 ssl;
    http2 on;
    server_name ${VPN_SERVER_NAME};

    ssl_certificate ${TLS_CERTIFICATE};
    ssl_certificate_key ${TLS_KEY};
    ssl_session_cache shared:mycleanbot_tls:2m;
    ssl_session_timeout 1d;

    allow 127.0.0.1;
    allow ${L3_OPERATOR_CIDR};
    deny all;

    location = /ingress-livez {
        access_log off;
        return 204;
    }

    location /static/ {
        proxy_pass http://mycleanbot_backend;
        proxy_http_version 1.1;
        proxy_set_header Connection "";
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto https;
        proxy_cache mycleanbot_static;
        proxy_cache_valid 200 1h;
        proxy_cache_lock on;
        add_header X-Content-Type-Options nosniff always;
    }

    location / {
        proxy_pass http://mycleanbot_backend;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_http_version 1.1;
        proxy_set_header Connection "";
    }
}
